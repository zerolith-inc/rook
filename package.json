{
  "name": "rook",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun run --parallel --filter \"@rook/app\" --filter \"@rook/api\" dev",
    "dev:app": "bun run --filter @rook/app dev",
    "dev:api": "bun run --filter @rook/api dev",
    "build": "vp run -r build",
    "typecheck": "vp run -r typecheck",
    "lint": "ultracite check",
    "format": "ultracite fix",
    "format:check": "ultracite check",
    "fix": "ultracite fix",
    "test": "node --test apps/api/src/*.test.ts",
    "check": "ultracite check && bun run typecheck && bun run test",
    "prepare": "vp hooks enable",
    "services:up": "docker compose up -d --wait",
    "services:down": "docker compose down",
    "services:oxigraph": "oxigraph serve --location .data/oxigraph --bind 127.0.0.1:7878"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "typescript": "~6.0.3",
    "ultracite": "7.11.1",
    "vite-plus": "0.3.2"
  },
  "overrides": {
    "expo-constants": "~57.0.18",
    "react-native-screens": "~4.26.0"
  },
  "engines": {
    "bun": ">=1.4.2",
    "node": ">=24.20.0"
  },
  "packageManager": "bun@1.4.2"
}
