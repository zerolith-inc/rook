{
  "name": "rook",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --parallel --filter \"@rook/app\" --filter \"@rook/api\" dev",
    "dev:app": "bun run --filter @rook/app dev",
    "dev:api": "bun run --filter @rook/api dev",
    "build": "vp run -r build",
    "typecheck": "vp run -r typecheck",
    "lint": "vp lint",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "test": "bun test",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test",
    "services:up": "docker compose up -d --wait",
    "services:down": "docker compose down"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "typescript": "~6.0.3",
    "vite-plus": "0.3.1"
  },
  "engines": {
    "bun": ">=1.3.13",
    "node": ">=22.13.0"
  },
  "packageManager": "bun@1.3.13"
}
